	///// Experiments with ST config files /////
    "build_systems":
    [
        {
		    "name": "SD Example Build",
            "target": "my_example_build",
            //"selector": "source.mylang",  // always appears if commented out
            "cancel": {"kill": true},

            "variants":
            [
                {
                    "name": "Lint",
                    "lint": true
                },
                {
                    "name": "Integration Tests",
                    "integration": true
                }
            ]
        },

		{
		    "name": "SD Run python script",
		    "selector": "source.python",
		    "file_patterns": [ "*.py"],
		    "env": { "PYTHONPATH": "C:\\Dev\\my_py_libs", },
		    "shell_cmd": "python \"$file\"",
		    "file_regex": "^\\s*File \"(...*?)\", line ([0-9]*)",
		},

		{
		    "name": "SD Run python Test File",
		    "selector": "source.python",
		    "file_patterns": ["test_*.py"],
		    "working_dir": "$project_path\\tests",
		    "shell_cmd": "python -m unittest \"$file\"",
		    "file_regex": "^\\s*File \"(...*?)\", line ([0-9]*)",
		},

		{
		    "name": "SD Run python Test All",
            // "selector": "source.python", // always appears if commented out
		    "working_dir": "$project_path",
		    "shell_cmd": "python -m unittest",
		    "file_regex": "^\\s*File \"(...*?)\", line ([0-9]*)",
		    "cancel": {"kill": true,},
		},

        {
            // always appears - no selector or file_patterns
            "name": "SD Default no selector",
		    "shell_cmd": "echo SD Default no selector | clip",
        },

